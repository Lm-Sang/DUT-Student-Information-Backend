NODE_ENV=development
PORT=3003
# Optional admin SSO module; student login works independently.
ENABLE_ADMIN_AUTH=false
APP_NAME=DUT Student Information Backend
APP_URL=http://localhost:3003
STUDENT_FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5173
# Comma-separated browser origins (scheme + host + optional port; no path).
# Add deployment origins for each web here.
CORS_STUDENT_ORIGINS=http://localhost:5173
CORS_ADMIN_ORIGINS=http://localhost:5173,http://localhost:5174

# Use "ssh" to forward SQL Server through the school server, or "direct" when
# port 1433 is reachable from the application host.
DB_CONNECTION_MODE=ssh
# SQL Server address reachable FROM the SSH host (may differ from SSH_HOST).
# Match DBeaver's SQL host. Use 127.0.0.1 only if SQL Server runs on the SSH host itself.
DB_HOST=
DB_PORT=1433
# Optional: leave blank to use each SQL login's default database.
DB_PRIMARY_DEFAULT_DATABASE=
DB_SECONDARY_DEFAULT_DATABASE=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DB_PRIMARY_USER=CDSBK
DB_PRIMARY_PASSWORD=
DB_SECONDARY_USER=CDSBK2
DB_SECONDARY_PASSWORD=

# Public curriculum: primary contains public programs and curriculum rows.
# DATA_SV2 contains course requirements; secondary supplements missing metadata.
CURRICULUM_PRIMARY_DATABASE=DHBK_CDS
CURRICULUM_METADATA_DATABASE=DATA_GVien1
CURRICULUM_REQUIREMENTS_DATABASE=DATA_SV2

# SSH jump host from root@<ip>.
SSH_HOST=
SSH_PORT=22
SSH_USER=root
SSH_PASSWORD=
SSH_PRIVATE_KEY_PATH=

# Independent local instance. Windows Authentication uses the account running Node.
# No LOCAL_DB_USER / LOCAL_DB_PASSWORD are required. School DB settings stay above.
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=1433
LOCAL_DB_NAME=sv_dut
LOCAL_DB_ODBC_DRIVER=ODBC Driver 17 for SQL Server
LOCAL_DB_ENCRYPT=false
LOCAL_DB_TRUST_SERVER_CERTIFICATE=true
LOCAL_DB_QUERY_TIMEOUT_MS=30000

JWT_SECRET=
# Persistent local auth store. Keep outside source control; back up/protect it.
# All workers on the same host must use this same file. Not for network shares.
AUTH_DATABASE_PATH=.data/auth.sqlite
JWT_EXPIRES_IN=1h
JWT_ISSUER=dut-student-information-backend
JWT_STUDENT_AUDIENCE=dut-student-information-student
JWT_ADMIN_AUDIENCE=dut-student-information-admin

# The course-registration backend uses the school's SSO gateway. This is not
# a direct Microsoft Entra ID OAuth client, so no tenant/client ID is needed.
MICROSOFT_SSO_BASE_URL=https://sso.dut.udn.vn
MICROSOFT_SSO_LOGIN_PATH=/microsoft/login
MICROSOFT_SSO_LOGOUT_PATH=/microsoft/logout
MICROSOFT_SSO_ME_PATH=/api/microsoft/me
# Separate redirect URLs for student and admin sign-in. Register both with SSO.
# React frontend exchanges the one-time handoff at /auth/callback.
MICROSOFT_SSO_STUDENT_CALLBACK_URL=http://localhost:3003/api/student/auth/microsoft/callback
MICROSOFT_SSO_ADMIN_CALLBACK_URL=http://localhost:3003/api/admin/auth/microsoft/callback
# Obtain the actual signing secret from the SSO administrator. Do not copy
# placeholder values from course-registration/appsettings.json.
MICROSOFT_SSO_JWT_SECRET=
# Configure once the gateway administrator confirms the actual issuer/audience.
MICROSOFT_SSO_JWT_ISSUER=
MICROSOFT_SSO_JWT_AUDIENCE=
# Must belong to STUDENT_FRONTEND_URL / ADMIN_FRONTEND_URL respectively.
STUDENT_SSO_FRONTEND_CALLBACK_URL=http://localhost:5173/auth/callback
ADMIN_SSO_FRONTEND_CALLBACK_URL=

# Public GET integrations. Each URL is the service root, before /api/...
COURSE_REGISTRATION_API_BASE_URL=https://dangkytinchi.dut.udn.vn
TKB_API_BASE_URL=https://timetable.dut.udn.vn
PUBLIC_API_TIMEOUT_MS=8000
PUBLIC_API_MAX_RESPONSE_BYTES=5242880

# Local-only request prototype. Never enable in production.
ENABLE_REQUESTS_DEMO=false

# Integrated request API and specialist JWT (see docs/INTEGRATION_AUTH_REQUESTS.md)
ENABLE_REQUESTS_API=true
ENABLE_DEMO_IMPERSONATION=false
JWT_SHARE_SSO_KEY=true
JWT_STAFF_AUDIENCE=dut-student-information-staff
MICROSOFT_SSO_JWT_SECRET_ENCODING=utf8
MICROSOFT_SSO_ALLOW_MISSING_AUDIENCE=false
AUTH_REFRESH_TTL_SECONDS=604800

# Shared student/staff test FE; use a separate origin in production if needed.
STAFF_FRONTEND_URL=http://localhost:5173
