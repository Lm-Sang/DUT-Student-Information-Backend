                "url": "{{baseUrl}}/api/certifications/management/types",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "description": " Mã/tên/bậc isSchoolProvided=true giữ nguyên nguồn; chỉ sửa form. TOEIC_FOUR là bổ sung local gắn TOEIC gốc. Mã có thể chứa khoảng trắng và chữ hoa/thường như Aptis Esol, TOEFLiBT.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"languageId\": {{languageId}},\n  \"code\": \"{{typeCode}}\",\n  \"displayName\": \"{{typeName}}\",\n  \"isPublished\": true,\n  \"formSchema\": {\n    \"fields\": [\n      {\n        \"key\": \"listening\",\n        \"label\": \"Nghe\",\n        \"type\": \"number\",\n        \"required\": true,\n        \"min\": 5,\n        \"max\": 495,\n        \"step\": 5\n      },\n      {\n        \"key\": \"reading\",\n        \"label\": \"Đọc\",\n        \"type\": \"number\",\n        \"required\": true,\n        \"min\": 5,\n        \"max\": 495,\n        \"step\": 5\n      },\n      {\n        \"key\": \"speaking\",\n        \"label\": \"Nói\",\n        \"type\": \"number\",\n        \"required\": true,\n        \"min\": 0,\n        \"max\": 200,\n        \"step\": 10\n      },\n      {\n        \"key\": \"writing\",\n        \"label\": \"Viết\",\n        \"type\": \"number\",\n        \"required\": true,\n        \"min\": 0,\n        \"max\": 200,\n        \"step\": 10\n      }\n    ]\n  }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{studentAccessToken}}",
                      "type": "string"
                    }
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('HTTP 201', function () { pm.expect(pm.response.code).to.eql(201); });",
                      "if (pm.response.code === 201) {",
                      "  const data = pm.response.json().data;",
                      "  pm.collectionVariables.set('certificateTypeId', data.id);",
                      "  pm.collectionVariables.set('typeRowVersion', data.rowVersion);",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Cập nhật mã, tên hoặc cấu hình form",
              "request": {
                "method": "PATCH",
                "url": "{{baseUrl}}/api/certifications/management/types/{{certificateTypeId}}",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "If-Match",
                    "value": "\"{{typeRowVersion}}\""
