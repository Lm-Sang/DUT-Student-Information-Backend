                  "raw": "{\n  \"languageId\": {{languageId}},\n  \"code\": \"{{typeCode}}\",\n  \"displayName\": \"{{typeName}}\",\n  \"isPublished\": true,\n  \"formSchema\": {\n    \"fields\": [\n      {\n        \"key\": \"listening\",\n        \"label\": \"Nghe\",\n        \"type\": \"number\",\n        \"required\": true,\n        \"min\": 5,\n        \"max\": 495,\n        \"step\": 5\n      },\n      {\n        \"key\": \"reading\",\n        \"label\": \"Đọc\",\n        \"type\": \"number\",\n        \"required\": true,\n        \"min\": 5,\n        \"max\": 495,\n        \"step\": 5\n      },\n      {\n        \"key\": \"speaking\",\n        \"label\": \"Nói\",\n        \"type\": \"number\",\n        \"required\": true,\n        \"min\": 0,\n        \"max\": 200,\n        \"step\": 10\n      },\n      {\n        \"key\": \"writing\",\n        \"label\": \"Viết\",\n        \"type\": \"number\",\n        \"required\": true,\n        \"min\": 0,\n        \"max\": 200,\n        \"step\": 10\n      }\n    ]\n  }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{studentAccessToken}}",
                      "type": "string"
                    }
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('HTTP 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                      "if (pm.response.code === 200) {",
                      "  const data = pm.response.json().data;",
                      "  pm.collectionVariables.set('certificateTypeId', data.id);",
                      "  pm.collectionVariables.set('typeRowVersion', data.rowVersion);",
                      "}"
                    ]
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "Công nhận theo khóa tuyển sinh",
          "item": [
            {
              "name": "Tạo quy định nhận theo khoảng khóa",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/certifications/management/policies",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "description": "Ví dụ Pháp: một khoảng 1900..2026=true, khoảng 2027..null=false. Không dùng isPublished để ngừng nhận các khóa sau. Chưa có quy định ngôn ngữ thì không nhận hồ sơ. Đặt certificateTypeId thay languageId nếu cần hạn chế riêng một loại.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"languageId\": {{languageId}},\n  \"cohortFrom\": {{cohortFrom}},\n  \"cohortTo\": {{cohortTo}},\n  \"isRecognized\": {{isRecognized}},\n  \"reason\": \"{{policyReason}}\",\n  \"documentReference\": \"Quy định của trường\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{studentAccessToken}}",
                      "type": "string"
                    }
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('HTTP 201', function () { pm.expect(pm.response.code).to.eql(201); });",
                      "if (pm.response.code === 201) {",
                      "  const data = pm.response.json().data;",
                      "  pm.collectionVariables.set('policyId', data.id);",
                      "  pm.collectionVariables.set('policyRowVersion', data.rowVersion);",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Cập nhật quy định theo khóa",
              "request": {
                "method": "PATCH",
                "url": "{{baseUrl}}/api/certifications/management/policies/{{policyId}}",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "If-Match",
                    "value": "\"{{policyRowVersion}}\""
                  }
                ],
                "description": "Gửi đầy đủ các trường, lấy token mới từ quản lý danh mục. Thu hẹp khoảng cũ trước khi thêm khoảng mới; các khoảng cùng đối tượng không được chồng lấn.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"languageId\": {{languageId}},\n  \"cohortFrom\": {{cohortFrom}},\n  \"cohortTo\": {{cohortTo}},\n  \"isRecognized\": {{isRecognized}},\n  \"reason\": \"{{policyReason}}\",\n  \"documentReference\": \"Quy định của trường\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{studentAccessToken}}",
                      "type": "string"
                    }
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('HTTP 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                      "if (pm.response.code === 200) {",
                      "  const data = pm.response.json().data;",
                      "  pm.collectionVariables.set('policyId', data.id);",
                      "  pm.collectionVariables.set('policyRowVersion', data.rowVersion);",
                      "}"
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Sinh viên",
      "item": [
        {
          "name": "Danh mục theo khóa của sinh viên",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/certifications/catalog",
            "header": [],
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json().data;",
                  "  const types = data.languages.flatMap(language => language.types);",
                  "  const type = types.find(x => x.code === pm.variables.get('typeCode'));",
                  "  pm.collectionVariables.set('certificateTypeId', type ? type.id : '');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Nộp hoặc bổ sung hồ sơ",
          "item": [
            {
              "name": "01 - Gửi kết quả và xin URL upload",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/certifications/applications",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "description": "Ví dụ TOEIC bốn kỹ năng. IELTS dùng result={overall:4.5}; cấp độ dùng result={level:\"B1\"}, theo formSchema thực tế. MSSV/khóa lấy từ hồ sơ server. Để bổ sung hoặc xin URL mới thêm applicationId vào body. Chỉ bổ sung khi needs_changes.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"data\": {\n    \"fullName\": \"{{fullName}}\",\n    \"className\": \"{{className}}\",\n    \"certificateTypeId\": {{certificateTypeId}},\n    \"issuedOn\": \"{{issuedOn}}\",\n    \"result\": {\n      \"listening\": 300,\n      \"reading\": 300,\n      \"speaking\": 130,\n      \"writing\": 140\n    }\n  },\n  \"files\": [\n    {\n      \"purpose\": \"{{filePurpose}}\",\n      \"fileName\": \"{{fileName}}\",\n      \"contentType\": \"{{fileContentType}}\",\n      \"sizeBytes\": {{fileBytes}}\n    }\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{studentAccessToken}}",
                      "type": "string"
                    }
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('HTTP 201', function () { pm.expect(pm.response.code).to.eql(201); });",
                      "if (pm.response.code === 201) {",
                      "  const data = pm.response.json().data;",
                      "  pm.collectionVariables.set('applicationId', data.applicationId);",
                      "  pm.collectionVariables.set('uploads', JSON.stringify(data.uploads));",
                      "  pm.collectionVariables.set('uploadIndex', '0');",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "02 - PUT ảnh lên R2: chọn Body binary",
              "request": {
                "method": "PUT",
                "url": "{{uploadUrl}}",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "{{uploadContentType}}"
                  },
                  {
                    "key": "If-None-Match",
                    "value": "{{uploadIfNoneMatch}}"
                  }
                ],
                "body": {
                  "mode": "file",
                  "file": {
                    "src": ""
                  }
                },
                "description": "Chọn ảnh đã kiểm tra đúng metadata đã khai. Upload thẳng vào evidence; gửi đầy đủ headers đã ký, gồm If-None-Match: * để không ghi đè ảnh. HTTP 412 nghĩa là key đã tồn tại, cần xin URL mới nếu upload lại. Nếu nhiều ảnh đổi uploadIndex 0,1,... và chọn binary tương ứng. Không ghép baseUrl backend.",
                "auth": {
                  "type": "noauth"
                }
              },
              "event": [
                {
                  "listen": "prerequest",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const uploads = JSON.parse(pm.variables.get('uploads') || '[]');",
                      "const upload = uploads[Number(pm.variables.get('uploadIndex') || 0)];",
                      "if (!upload) throw new Error('Chạy xin URL trước hoặc kiểm tra uploadIndex.');",
                      "pm.variables.set('uploadUrl', upload.url);",
                      "pm.variables.set('uploadContentType', upload.headers['Content-Type']);",
                      "pm.variables.set('uploadIfNoneMatch', upload.headers['If-None-Match']);"
                    ]
                  }
                },
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('HTTP 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                      "if (pm.response.code === 200) {",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "03 - Kiểm tra ảnh và nộp",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/certifications/applications/{{applicationId}}/complete",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "description": "",
                "body": {
                  "mode": "raw",
                  "raw": "{}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
