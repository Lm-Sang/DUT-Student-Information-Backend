                    "value": "application/json"
                  },
                  {
                    "key": "If-Match",
                    "value": "\"{{languageRowVersion}}\""
                  }
                ],
                "description": "",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"code\": \"{{languageCode}}\",\n  \"displayName\": \"{{languageName}}\",\n  \"isPublished\": true\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{studentAccessToken}}",
                      "type": "string"
                    }
                  ]
