  "item": [
    {
      "name": "01 - Quản lý danh mục (quyền riêng)",
      "item": [
        {
          "name": "Đọc toàn bộ danh mục, cấu hình và token cập nhật",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/certifications/management/catalog",
            "header": [],
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentAccessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "if (pm.response.code === 200) {",
                  "  const catalog = pm.response.json().data;",
                  "  const language = catalog.languages.find(x => x.code === pm.variables.get('languageCode'));",
                  "  const type = catalog.types.find(x => x.code === pm.variables.get('typeCode'));",
                  "  if (language) { pm.collectionVariables.set('languageId', language.id); pm.collectionVariables.set('languageRowVersion', language.rowVersion); }",
                  "  if (type) { pm.collectionVariables.set('certificateTypeId', type.id); pm.collectionVariables.set('typeRowVersion', type.rowVersion); pm.collectionVariables.set('typeName', type.displayName); }",
                  "  const policy = catalog.policies.find(x => String(x.id) === String(pm.variables.get('policyId')));",
                  "  if (policy) pm.collectionVariables.set('policyRowVersion', policy.rowVersion);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Ngôn ngữ",
          "item": [
            {
              "name": "Tạo ngôn ngữ",
              "request": {
                "method": "POST",
                "url": "{{baseUrl}}/api/certifications/management/languages",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "description": "Chỉ tạo ngôn ngữ mới chưa có. LN001..LN004 đã nhập từ mã nguồn trường, không tạo lại hoặc đổi mã.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"code\": \"{{languageCode}}\",\n  \"displayName\": \"{{languageName}}\",\n  \"isPublished\": true\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{studentAccessToken}}",
                      "type": "string"
                    }
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test('HTTP 201', function () { pm.expect(pm.response.code).to.eql(201); });",
                      "if (pm.response.code === 201) {",
                      "  const data = pm.response.json().data;",
                      "  pm.collectionVariables.set('languageId', data.id);",
                      "  pm.collectionVariables.set('languageRowVersion', data.rowVersion);",
                      "}"
                    ]
                  }
                }
              ]
            },
